{
  "name": "vibe-player",
  "version": "0.2.0",
  "description": "Cinematic, provider-agnostic React video player primitives and skins.",
  "keywords": [
    "video-player",
    "react",
    "hls",
    "youtube",
    "captions",
    "design-system",
    "cinematic-ui"
  ],
  "homepage": "https://github.com/vcode-sh/vibe-player#readme",
  "bugs": {
    "url": "https://github.com/vcode-sh/vibe-player/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcode-sh/vibe-player.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/vcode-sh"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Vibe Code",
    "email": "hello@vcode.sh",
    "url": "https://x.com/vcode_sh"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vibe-player-media-audit": "scripts/audit-media-delivery.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist",
    "docs/integration.md",
    "docs/media-delivery.md",
    "docs/usage.md",
    "scripts/audit-media-delivery.mjs",
    "scripts/media-delivery-audit-args.mjs",
    "scripts/media-delivery-audit-cors.mjs",
    "scripts/media-delivery-audit-core.mjs",
    "scripts/media-delivery-audit-deadline.mjs",
    "scripts/media-delivery-audit-fetch.mjs",
    "scripts/media-delivery-audit-findings.mjs",
    "scripts/media-delivery-audit-format.mjs",
    "scripts/media-delivery-audit-mp4.mjs",
    "scripts/media-delivery-audit-rollout.mjs",
    "scripts/media-delivery-audit-runner.mjs"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --out-dir dist --platform neutral --target es2022 --deps.never-bundle react --deps.never-bundle react-dom --deps.never-bundle hls.js && bun scripts/build-styles.mjs",
    "check": "biome check .",
    "check-types": "tsc --noEmit",
    "ci": "bun run check && bun run package:rules && bun run package:boundaries && bun run package:dependencies && bun run package:release-state && bun run check-types && bun run test && bun run build && bun run package:styles && bun run package:size && bun run package:surface && bun run package:tarball && bun run package:publint && bun run package:attw && bun run demo:vite:verify && bun run package:consumer && bun run test:youtube:check && bun run test:browser:check && bun run test:browser",
    "demo:vite": "vite --config demo/vite/vite.config.ts --host localhost",
    "demo:vite:build": "vite build --config demo/vite/vite.config.ts",
    "demo:vite:check": "tsc -p demo/vite/tsconfig.json --noEmit",
    "demo:vite:packaged": "bun run build && vite --config demo/vite/vite.config.ts --mode packaged --host localhost",
    "demo:vite:packaged:build": "bun run build && vite build --config demo/vite/vite.config.ts --mode packaged",
    "demo:vite:verify": "bun run demo:vite:check && bun run demo:vite:build && vite build --config demo/vite/vite.config.ts --mode packaged",
    "lint": "biome lint .",
    "lint:fix": "ultracite fix .",
    "media:audit": "bun scripts/audit-media-delivery.mjs",
    "package:attw": "attw . --pack --profile esm-only --exclude-entrypoints ./styles.css",
    "package:boundaries": "bun scripts/assert-package-boundaries.mjs",
    "package:consumer": "node scripts/assert-packed-consumer.mjs",
    "package:dependencies": "bun scripts/assert-package-dependencies.mjs",
    "package:publint": "publint run --strict --pack npm",
    "package:release-state": "bun scripts/assert-release-state.mjs",
    "package:rules": "bun scripts/assert-coding-rules.mjs",
    "package:size": "bun scripts/assert-package-size.mjs",
    "package:styles": "bun scripts/assert-built-styles.mjs",
    "package:surface": "bun scripts/assert-public-surface.mjs",
    "package:tarball": "bun scripts/assert-package-tarball.mjs",
    "release:publish": "changeset publish",
    "release:version": "changeset version && bun install",
    "test": "vitest run",
    "test:accessibility:native": "node test/browser/accessibility-native.mjs",
    "test:browser": "playwright test",
    "test:browser:check": "tsc -p test/browser/tsconfig.json --noEmit",
    "test:watch": "vitest",
    "test:youtube": "playwright test --config playwright.youtube.config.ts",
    "test:youtube:check": "tsc -p test/youtube-live/tsconfig.json --noEmit"
  },
  "dependencies": {
    "entities": "7.0.1",
    "hls.js": "1.7.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "publint": "0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "patchedDependencies": {
    "ultracite@8.0.1": "patches/ultracite@8.0.1.patch"
  }
}
