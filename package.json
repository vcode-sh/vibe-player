{
  "name": "@vibe-code/vibe-player",
  "version": "0.1.0",
  "private": true,
  "description": "Cinematic, provider-agnostic React video player primitives and skins.",
  "author": "Vibe Code",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "./src/styles/*.css"
  ],
  "files": [
    "dist",
    "src/styles/*.css",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/vibe-player.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "restricted",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "keywords": [
    "video-player",
    "react",
    "hls",
    "youtube",
    "captions",
    "design-system",
    "cinematic-ui"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --sourcemap --out-dir dist --platform neutral --deps.never-bundle react --deps.never-bundle react-dom --deps.never-bundle hls.js",
    "check": "biome check .",
    "check-types": "tsc --noEmit",
    "ci": "bun run check && bun run check-types && bun run test && bun run build && bun run package:publint && bun run package:attw",
    "lint": "biome lint .",
    "lint:fix": "ultracite fix .",
    "package:attw": "attw . --pack --profile esm-only --exclude-entrypoints ./styles.css",
    "package:publint": "publint run --strict --pack npm",
    "release:publish": "changeset publish",
    "release:version": "changeset version && bun install",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "^2.4.16",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "20.10.2",
    "publint": "0.3.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "ultracite": "^7.8.2",
    "vitest": "^4.1.8"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "hls.js": "1.6.16"
  }
}
